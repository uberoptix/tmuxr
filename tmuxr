#!/usr/bin/env bash
#
# tmuxr — interactive whiptail menu for managing tmux sessions.
#
# Usage:
#   tmuxr            interactive menu (default)
#   tmuxr -l|--list  print sessions and exit
#   tmuxr -h|--help  show help
#
set -u

RED=$'\033[0;31m'
NC=$'\033[0m'

die()  { printf '%s%s%s\n' "$RED" "$*" "$NC" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
    cat <<EOF
tmuxr — interactive tmux session manager

Usage:
  tmuxr            launch the menu (default)
  tmuxr -l|--list  list current sessions and exit
  tmuxr -h|--help  show this help
EOF
}

require_deps() {
    have tmux     || die "tmux is not installed."
    have whiptail || die "whiptail is not installed (Debian/Ubuntu: apt-get install whiptail; Synology: install via Entware)."
}

list_sessions() {
    tmux list-sessions -F "#S" 2>/dev/null || true
}

# Brand the session's status bar:
#   left   — tmux's default status-left (session name etc.)
#   centre — literal "tmuxr"
#   right  — detach reminder
# Overrides status-format[0], which displaces the default window list;
# users still navigate windows via C-b w / C-b <number>.
apply_status_bar() {
    local target=$1
    tmux set-option -t "$target" status-right-length 50 >/dev/null 2>&1 || true
    tmux set-option -t "$target" status-right " To Detach: Ctrl-B, then D " >/dev/null 2>&1 || true
    tmux set-option -t "$target" 'status-format[0]' \
        '#[align=left]#{T:status-left}#[align=centre]tmuxr#[align=right]#{T:status-right}' \
        >/dev/null 2>&1 || true
}

# Per tmux: session names cannot contain ':' or '.', and cannot be empty.
valid_name() {
    local name=$1
    [[ -n "$name" && "$name" != *:* && "$name" != *.* ]]
}

prompt_input() {
    # Echo the user's input on stdout; return non-zero on Cancel/Esc so
    # callers can distinguish "cancelled" from "submitted empty".
    local title=$1 prompt=$2 default=${3-}
    whiptail --title "$title" \
        --ok-button "OK" --cancel-button "Back" \
        --inputbox "$prompt" 10 60 "$default" 3>&1 1>&2 2>&3
}

create_session() {
    local name
    name=$(prompt_input "New session" "Enter new session name") || return 1
    if ! valid_name "$name"; then
        whiptail --msgbox "Invalid name. Session names cannot be empty or contain ':' or '.'" 9 70
        return 1
    fi
    if tmux has-session -t "=$name" 2>/dev/null; then
        whiptail --msgbox "Session '$name' already exists." 8 60
        return 1
    fi
    if tmux new-session -d -s "$name"; then
        apply_status_bar "$name"
        printf '%s' "$name"
        return 0
    fi
    whiptail --msgbox "Failed to create session '$name'." 8 60
    return 1
}

manage_session() {
    local target=$1
    local action
    # Trailing spaces on tags widen whiptail's tag column for readability.
    # The case below matches with wildcards so the padding is harmless.
    action=$(whiptail --title "Session: $target" \
        --ok-button "Select" --cancel-button "Back" \
        --menu "Choose an action" 15 60 4 \
        "Attach    " "Attach to the session" \
        "Kill      " "Kill the session" \
        "Rename    " "Rename the session" \
        3>&1 1>&2 2>&3) || return 0

    case $action in
        Attach*)
            apply_status_bar "$target"
            tmux attach-session -t "$target"
            ;;
        Kill*)
            if whiptail --yesno "Kill session '$target'?" 8 60; then
                tmux kill-session -t "$target"
            fi
            ;;
        Rename*)
            local new
            new=$(prompt_input "Rename" "New name for '$target'" "$target") || return 0
            if valid_name "$new"; then
                tmux rename-session -t "$target" "$new"
            else
                whiptail --msgbox "Invalid name." 8 40
            fi
            ;;
    esac
}

menu_loop() {
    local preselected=""
    while true; do
        local choice
        if [[ -n "$preselected" ]]; then
            choice=$preselected
            preselected=""
        else
            local sessions
            # Append PAD trailing spaces to every tag so whiptail allocates
            # a wider tag column. We strip exactly PAD spaces back off after
            # selection, so user-provided session names round-trip cleanly.
            local PAD="    "
            local options=("NEW${PAD}" "Create a new session")
            sessions=$(list_sessions)
            if [[ -n "$sessions" ]]; then
                while IFS= read -r s; do
                    options+=("${s}${PAD}" "Select to manage")
                done <<<"$sessions"
                options+=("KILL_ALL${PAD}" "Terminate all sessions")
            fi

            choice=$(whiptail --title "tmuxr — Manage tmux Sessions" \
                --ok-button "Select" --cancel-button "Exit" \
                --menu "Choose a session or create a new one" 25 80 15 \
                "${options[@]}" 3>&1 1>&2 2>&3) || return 0
            choice=${choice%"$PAD"}
        fi

        case $choice in
            NEW)
                if name=$(create_session); then
                    preselected=$name  # auto-attach on next iteration
                fi
                ;;
            KILL_ALL)
                if whiptail --yesno "Terminate ALL tmux sessions?" 8 60; then
                    tmux kill-server 2>/dev/null || true
                fi
                ;;
            *)
                manage_session "$choice"
                ;;
        esac
    done
}

main() {
    case ${1:-} in
        -h|--help) usage; exit 0 ;;
        -l|--list) require_deps; list_sessions; exit 0 ;;
        "" )       ;;
        *  )       usage; exit 2 ;;
    esac
    require_deps
    menu_loop
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
